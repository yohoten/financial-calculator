# ---------------------------------------------------------------------------
# 生成产物（每次运行都会重建，不提交）
# ---------------------------------------------------------------------------
# 只按"目录"忽略，不再按 *.png / *.pdf 这类扩展名全局通配。
# 原因：全局通配会把 docs/figures/ 的报告插图和 docs/开发报告.pdf 一并忽略，
#      导致远程仓库里的开发报告插图全部 404——本地看不出问题，极易漏判。
outputs/
output/
gui_临时截图/

# ---------------------------------------------------------------------------
# 交付资产（必须提交，显式保留）
# ---------------------------------------------------------------------------
!docs/figures/*.png
!docs/excel/*.xlsx
!docs/*.pdf

# 运行期兜底日志
启动错误.log

# Data cache
*.pkl
*.pickle
.cache/

# Logs
*.log

# Environment variables
.env
.env.local

# Temporary files
tmp/
temp/
*.tmp
